# Copy to .env to enable an LLM for the copilot. Without it the copilot uses its rule-based fallback.
#
# Any OpenAI-compatible API (OpenAI, Groq, OpenRouter, Together, LM Studio):
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=...
# AI_MODEL=llama-3.3-70b-versatile
#
# Anthropic Claude:
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5-5
#
# Local Ollama:
# AI_PROVIDER=ollama
# AI_BASE_URL=http://host.docker.internal:11434
# AI_MODEL=qwen2.5:1.5b

JWT_SECRET=change-me-in-production-this-is-a-32+-byte-dev-secret
